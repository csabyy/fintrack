generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String           @unique
  password        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  accounts        BankAccount[]
  categories      Category[]
  preference      UserPreference?
  budgets         Budget[]
  bankConnections BankConnection[]
}

model UserPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStartsOn  Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, categoryId])
  @@index([userId])
}

model BankConnection {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccountId     String      @unique
  bankAccount       BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  truelayerAccountId String
  accountType       String      @default("account") // "account" or "card"
  accessToken       String      @db.Text
  refreshToken      String      @db.Text
  tokenExpiresAt    DateTime
  lastSyncedAt      DateTime?
  lastSyncAttemptAt DateTime?
  lastSyncError     String?
  logoUri           String?
  consentExpiresAt  DateTime?   // from TrueLayer; the user must reconnect after this
  createdAt         DateTime    @default(now())  // when the bank was (re)connected
  updatedAt         DateTime    @updatedAt

  @@index([userId])
}

model BankAccount {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  bankName     String
  type         AccountType   @default(CURRENT)
  balance      Float         @default(0)
  color        String        @default("#10b981")
  notes        String?
  creditLimit  Float?
  promoEndDate  DateTime?    // credit cards: end of the 0% interest period
  statementDay  Int?         // credit cards: day of month the statement is issued (1-31)
  paymentDueDay Int?         // credit cards: day of month the payment is due (1-31)
  cardNetwork  String?       // e.g. "VISA", "MASTERCARD"
  lastFourDigits String?
  validFrom    String?       // YYYY-MM from TrueLayer
  validTo      String?       // YYYY-MM from TrueLayer
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[] @relation("AccountTransactions")
  transfersOut Transaction[] @relation("TransferFrom")
  bankConnection  BankConnection?

  @@index([userId])
}

enum AccountType {
  CURRENT
  CREDIT_CARD
}

model Transaction {
  id             String          @id @default(cuid())
  accountId      String
  account        BankAccount     @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id])
  date           DateTime
  description    String
  amount         Float
  type           TransactionType @default(EXPENSE)
  transferToId   String?
  transferTo     BankAccount?    @relation("TransferFrom", fields: [transferToId], references: [id])
  notes          String?
  importedFrom   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([accountId])
  @@index([date])
  @@index([categoryId])
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

model Category {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  color        String        @default("#10b981")
  icon         String?
  isDefault    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name])
  @@index([userId])
}

// One-off data fixes in prisma/data-migrations/after-push.sql record themselves here
model DataMigration {
  id        String   @id
  appliedAt DateTime @default(now())
}
